	(text "B2 frozen source hashes are asserted before generation; source files are never rewritten."
		(exclude_from_sim no)
		(at 30.00 396.00 0)
		(effects (font (size 0.85 0.85)) (justify left))
		(uuid "9e98c439-6a4f-5497-bf37-c2d423713fd4")
	)
	(text "Former B2 3V3 semantics are EPD_SW_3V3; R4/R8 preserve the proven downstream EPD_3V3/V_B distribution."
		(exclude_from_sim no)
		(at 30.00 400.50 0)
		(effects (font (size 0.85 0.85)) (justify left))
		(uuid "85d7c104-80de-5d24-9943-6c33d245de4f")
	)
	(text "J2 is DNP debug only and uses MCU-side nets. Never populate J2 with U1 or drive panel nets around the buffers."
		(exclude_from_sim no)
		(at 30.00 405.00 0)
		(effects (font (size 0.85 0.85)) (justify left))
		(uuid "483d73ff-18ac-54e4-bb12-06a2ee98e017")
	)
	(text "Panel-side defaults: CSB/CS2 pull high to EPD_3V3; RST/DC/SCL/SI0 pull low. MCU_BUSY_N pulls high."
		(exclude_from_sim no)
		(at 30.00 409.50 0)
		(effects (font (size 0.85 0.85)) (justify left))
		(uuid "6be36d80-38a2-5521-b238-00031e5b67f1")
	)
	(text "Power defaults: EPD ON and EPD_BUF_CONNECT pull low; R36 pulls U6 OE_N high to EPD_3V3."
		(exclude_from_sim no)
		(at 30.00 414.00 0)
		(effects (font (size 0.85 0.85)) (justify left))
		(uuid "e982ffaf-c4fe-5408-b4f1-d5fb39785470")
	)
	(text "Enable order: GPIO38 low -> enable TPS22950 -> wait for EPD rail -> GPIO38 high. Disable in reverse."
		(exclude_from_sim no)
		(at 30.00 418.50 0)
		(effects (font (size 0.85 0.85)) (justify left))
		(uuid "5b855d6b-10de-5242-b4e3-1d0b925a7a64")
	)
	(text "U6 SN74CB3Q3245PWR preserves SI0 bidirectional readback and provides Ioff isolation when EPD_3V3 is absent."
		(exclude_from_sim no)
		(at 30.00 423.00 0)
		(effects (font (size 0.85 0.85)) (justify left))
		(uuid "1bda3a3f-07d8-57e8-9e23-c84120353110")
	)
